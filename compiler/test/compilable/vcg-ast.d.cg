miniFormatFakeAttributes!bool
{
	pure nothrow @nogc @safe string miniFormatFakeAttributes(ref scope const(bool) t)
	{
		alias miniT = pure nothrow @nogc @safe string miniFormat(ref scope const(bool) v)
		{
			import core.internal.traits : isAggregateType;
			return v ? "true" : "false";
		}
		;
		return (*assumeFakeAttributes(& miniFormat))(t);
	}

}
miniFormat!bool
