mixin _d_cmain!();
{
	extern (C)
	{
		extern (C) int _d_run_main(int argc, char** argv, void* mainFunc);
		extern (C) int _Dmain(char[][] args);
		version (Emscripten)
		{
			pragma (mangle, "__main_argc_argv")export extern (C) int main(int argc, char** argv)
			{
				return _d_run_main(argc, argv, &_Dmain);
			}
		}
		else
		{
			version (OD_TestRunner)
			{
			}
			else
			{
				extern (C) int main(int argc, char** argv)
				{
					return _d_run_main(argc, argv, & _Dmain);
				}
			}
		}
		version (Solaris)
		{
			extern (C) int _main(int argc, char** argv)
			{
				return main(argc, argv);
			}
		}
	}
}
_d_assert_fail!bool
{
	string _d_assert_fail(B...)(scope const string comp, auto ref scope const A a, auto ref scope const B b) if (B.length != 0 || A.length != 1)
	{
		if (inFinalizer())
			return "Assertion failed (rich formatting is disabled in finalizers)";
		string[A.length + B.length] vals;
		static foreach (idx; 0 .. A.length)
		{
			vals[idx] = miniFormatFakeAttributes(a[idx]);
		}
		static foreach (idx; 0 .. B.length)
		{
			vals[A.length + idx] = miniFormatFakeAttributes(b[idx]);
		}
		immutable token = invertCompToken(comp);
		return combine(vals[0..A.length], token, vals[A.length..__dollar]);
	}

}
_d_assert_fail!bool
{
	pure nothrow @nogc @safe string _d_assert_fail(scope const(string) op, scope const(bool) a)
	{
		if (inFinalizer())
			return "Assertion failed (rich formatting is disabled in finalizers)";
		string[2] vals = [miniFormatFakeAttributes(a), "true"];
		immutable immutable(string) token = __equals(op, "!") ? "==" : "!=";
		return combine(vals[0..1], token, vals[1..2]);
	}

}
inFinalizer!()
{
	pure nothrow @nogc @safe bool inFinalizer()
	{
		import core.memory : GC;
		return !__ctfe && (*assumeFakeAttributes(& inFinalizer))();
	}

}
assumeFakeAttributes!(extern (C) bool function() nothrow @nogc @safe)
{
	auto pure nothrow @nogc @trusted bool function() pure nothrow @nogc @safe assumeFakeAttributes(extern (C) bool function() nothrow @nogc @safe t)
	{
		import core.internal.traits : Parameters, ReturnType;
		alias RT = bool;
		alias P = ();
		alias type = bool function() pure nothrow @nogc @safe;
		return cast(bool function() pure nothrow @nogc @safe)t;
	}

}
